{
  "compilerOptions": {
    "declaration": true,
    "strictNullChecks": true,
    "target": "es6",
    "outDir": "lib",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "types": ["node"],
    "sourceMap": true,
    "removeComments": false,
    "lib": [
      "es2015",
    ],
    "rootDir": "src"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}
